<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0">Reservations</h1>
    <p class="text-muted mb-0">Bookings, check-ins, and check-outs</p>
  </div>
  <a href="/reservations/new" class="btn btn-primary">+ New Booking</a>
</div>

<% if (reservations.length === 0) { %>
  <div class="text-center py-5">
    <p class="text-muted">No reservations yet.</p>
    <a href="/reservations/new" class="btn btn-primary">Create the first booking</a>
  </div>
<% } else { %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Guest</th>
            <th>Room</th>
            <th>Dates</th>
            <th>Status</th>
            <th>Total</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% reservations.forEach(r => { %>
            <tr>
              <td>#<%= r.id %></td>
              <td>
                <a href="/guests/<%= r.guest_id %>" class="text-decoration-none brand-navy">
                  <%= r.guest.full_name %>
                </a>
              </td>
              <td>Room <%= r.room.room_number %></td>
              <td>
                <small>
                  <%= new Date(r.check_in_date).toLocaleDateString() %> 
                  → 
                  <%= new Date(r.check_out_date).toLocaleDateString() %>
                </small>
              </td>
              <td>
                <span class="badge 
                  <%= r.status === 'booked' ? 'bg-primary' : '' %>
                  <%= r.status === 'checked_in' ? 'bg-success' : '' %>
                  <%= r.status === 'checked_out' ? 'bg-secondary' : '' %>
                  <%= r.status === 'cancelled' ? 'bg-danger' : '' %>
                ">
                  <%= r.status.replace('_', ' ') %>
                </span>
              </td>
              <td>$<%= Number(r.total_amount).toFixed(2) %></td>
              <td class="text-end">
                <a href="/reservations/<%= r.id %>" class="btn btn-sm btn-outline-primary">Manage</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
