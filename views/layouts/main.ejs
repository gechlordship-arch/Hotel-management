<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> | Karnid International Hotel & Spa. Injibara</title>
  <link rel="icon" type="image/jpeg" href="/images/logo/logo.jpg" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark karnid-navbar mb-4">
    <div class="container">
     <a class="navbar-brand d-flex align-items-center gap-2" href="<%= currentUser ? '/dashboard' : '/login' %>"></a>
        <span class="karnid-logo-wrap">
          <img src="/images/logo/logo.jpg" alt="Karnid" class="karnid-logo" />
        </span>
        <span class="brand-text d-none d-md-inline">
          Karnid International <span class="brand-accent">Hotel &amp; SPA</span>
        </span>
      </a>
      <div class="ms-auto">
        <% if (currentUser) { %>
          <span class="text-light me-3 d-none d-md-inline">
            <%= currentUser.name %> <span class="text-warning">·</span> <%= currentUser.role %>
          </span>
          <form action="/logout" method="POST" class="d-inline">
            <button class="btn btn-sm btn-outline-warning">Logout</button>
          </form>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container">
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <%- body %>
  </div>

  <footer class="karnid-footer text-center py-4 mt-5">
    <div class="container">
      <img src="/images/logo/logo.jpg" alt="Karnid" class="karnid-footer-logo mb-2" />
      <p class="mb-0 fw-bold brand-navy">Karnid International Hotel &amp; SPA</p>
      <p class="mb-0 text-muted small">Luxury. Comfort. Wellness.</p>
      <p class="mb-0 text-muted small mt-2">© <%= new Date().getFullYear() %> — Management System</p>
    </div>
  </footer>
</body>
</html>