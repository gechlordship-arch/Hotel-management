<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card p-4 p-md-5">
      <div class="text-center mb-4">
        <img src="/images/logo/logo.jpg" alt="Karnid" style="height:56px; border-radius:8px;" />
        <h3 class="mt-3 mb-1">Join Karnid Staff</h3>
        <p class="text-muted small mb-0">Create your staff account</p>
      </div>

      <form action="/register" method="POST">
        <div class="mb-3">
          <label class="form-label">Full Name</label>
          <input type="text" name="name" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required minlength="6" />
          <div class="form-text">Minimum 6 characters</div>
        </div>
        <button class="btn btn-primary w-100 py-2">Create Account</button>
      </form>

      <p class="mt-4 mb-0 text-center small text-muted">
        Have an account? <a href="/login" class="brand-navy fw-semibold">Sign In</a>
      </p>
    </div>
  </div>
</div>