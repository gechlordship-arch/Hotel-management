<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0">Rooms</h1>
    <p class="text-muted mb-0">All rooms across Karnid International Hotel &amp; SPA</p>
  </div>
  <a href="/rooms/new" class="btn btn-primary">+ Add Room</a>
</div>

<div class="row g-3">
  <% rooms.forEach(room => { %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <img src="<%= room.image_url || '/images/rooms/room.png' %>"
             class="card-img-top"
             style="height:180px; object-fit:cover; border-radius:14px 14px 0 0;"
             alt="Room <%= room.room_number %>" />
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
              <h5 class="mb-0">Room <%= room.room_number %></h5>
              <small class="text-muted">
                <%= room.roomType ? room.roomType.name : '—' %> · Floor <%= room.floor %>
              </small>
            </div>
            <span class="badge
              <%= room.status === 'available' ? 'bg-success' : '' %>
              <%= room.status === 'occupied' ? 'bg-danger' : '' %>
              <%= room.status === 'cleaning' ? 'bg-warning text-dark' : '' %>
              <%= room.status === 'maintenance' ? 'bg-secondary' : '' %>
            ">
              <%= room.status %>
            </span>
          </div>

          <% if (room.roomType) { %>
            <p class="mb-1 small">
              <strong>$<%= Number(room.roomType.base_price).toFixed(2) %></strong> / night
              · sleeps <%= room.roomType.capacity %>
            </p>
          <% } %>

          <div class="mt-3 d-flex gap-2">
            <a href="/rooms/<%= room.id %>" class="btn btn-sm btn-outline-primary">View</a>
            <a href="/rooms/<%= room.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            <form action="/rooms/<%= room.id %>/delete" method="POST" class="d-inline"
                  onsubmit="return confirm('Delete room <%= room.room_number %>?');">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<% if (rooms.length === 0) { %>
  <div class="text-center py-5">
    <p class="text-muted">No rooms yet.</p>
    <a href="/rooms/new" class="btn btn-primary">Add the first room</a>
  </div>
<% } %>
