<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Add Guest</h1>
  <a href="/guests" class="btn btn-outline-secondary">← Back</a>
</div>

<div class="card p-4">
  <form action="/guests" method="POST">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Full Name *</label>
        <input type="text" name="full_name" class="form-control" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Phone *</label>
        <input type="text" name="phone" class="form-control" required placeholder="+251 91 234 5678" />
      </div>

      <div class="col-md-6">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Country</label>
        <input type="text" name="country" class="form-control" placeholder="Ethiopia" />
      </div>

      <div class="col-12">
        <label class="form-label">Address</label>
        <textarea name="address" class="form-control" rows="2"></textarea>
      </div>

      <div class="col-md-6">
        <label class="form-label">ID Proof Type</label>
        <select name="id_proof_type" class="form-select">
          <option value="">— None —</option>
          <% idTypes.forEach(t => { %>
            <option value="<%= t %>"><%= t.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">ID Proof Number</label>
        <input type="text" name="id_proof_number" class="form-control" />
      </div>

      <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control" rows="2" placeholder="VIP, allergies, preferences..."></textarea>
      </div>

      <div class="col-12">
        <button class="btn btn-primary">Save Guest</button>
        <a href="/guests" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </div>
  </form>
</div>
