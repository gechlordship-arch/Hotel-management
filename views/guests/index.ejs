<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0">Guests</h1>
    <p class="text-muted mb-0">All guests registered at Karnid International Hotel &amp; SPA</p>
  </div>
  <a href="/guests/new" class="btn btn-primary">+ Add Guest</a>
</div>

<form method="GET" action="/guests" class="mb-3">
  <div class="input-group">
    <input type="text" name="q" class="form-control"
           placeholder="Search by name, phone, or email..."
           value="<%= q || '' %>" />
    <button class="btn btn-outline-secondary">Search</button>
    <% if (q) { %>
      <a href="/guests" class="btn btn-outline-secondary">Clear</a>
    <% } %>
  </div>
</form>

<% if (guests.length === 0) { %>
  <div class="text-center py-5">
    <p class="text-muted">
      <% if (q) { %>No guests match "<%= q %>".<% } else { %>No guests yet.<% } %>
    </p>
    <a href="/guests/new" class="btn btn-primary">Add the first guest</a>
  </div>
<% } else { %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Country</th>
            <th>ID</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% guests.forEach(g => { %>
            <tr>
              <td>
                <a href="/guests/<%= g.id %>" class="text-decoration-none fw-semibold brand-navy">
                  <%= g.full_name %>
                </a>
              </td>
              <td><%= g.phone %></td>
              <td><%= g.email || '—' %></td>
              <td><%= g.country || '—' %></td>
              <td>
                <% if (g.id_proof_type) { %>
                  <span class="badge bg-light text-dark">
                    <%= g.id_proof_type.replace('_', ' ') %>
                  </span>
                <% } else { %>—<% } %>
              </td>
              <td class="text-end">
                <a href="/guests/<%= g.id %>" class="btn btn-sm btn-outline-primary">View</a>
                <a href="/guests/<%= g.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form action="/guests/<%= g.id %>/delete" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete guest <%= g.full_name %>?');">
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="text-muted small mt-2"><%= guests.length %> guest<%= guests.length === 1 ? '' : 's' %> found</p>
<% } %>
