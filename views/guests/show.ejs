<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0"><%= guest.full_name %></h1>
    <p class="text-muted mb-0">Guest profile</p>
  </div>
  <div>
    <a href="/guests/<%= guest.id %>/edit" class="btn btn-outline-secondary">Edit</a>
    <a href="/guests" class="btn btn-outline-secondary">← All Guests</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card p-4 h-100">
      <h5 class="mb-3">Contact</h5>
      <dl class="row mb-0">
        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8"><%= guest.phone %></dd>
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8"><%= guest.email || '—' %></dd>
        <dt class="col-sm-4">Country</dt>
        <dd class="col-sm-8"><%= guest.country || '—' %></dd>
        <dt class="col-sm-4">Address</dt>
        <dd class="col-sm-8"><%= guest.address || '—' %></dd>
      </dl>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card p-4 h-100">
      <h5 class="mb-3">Identity</h5>
      <dl class="row mb-0">
        <dt class="col-sm-5">ID Type</dt>
        <dd class="col-sm-7">
          <% if (guest.id_proof_type) { %>
            <span class="badge bg-light text-dark"><%= guest.id_proof_type.replace('_', ' ') %></span>
          <% } else { %>—<% } %>
        </dd>
        <dt class="col-sm-5">ID Number</dt>
        <dd class="col-sm-7"><%= guest.id_proof_number || '—' %></dd>
        <dt class="col-sm-5">Guest Since</dt>
        <dd class="col-sm-7"><%= new Date(guest.created_at).toLocaleDateString() %></dd>
      </dl>
    </div>
  </div>

  <% if (guest.notes) { %>
    <div class="col-12">
      <div class="card p-4">
        <h5 class="mb-3">Notes</h5>
        <p class="mb-0"><%= guest.notes %></p>
      </div>
    </div>
  <% } %>

  <div class="col-12">
    <div class="card p-4">
      <h5 class="mb-3">Reservations</h5>
      <p class="text-muted mb-0">Booking history will appear here once the Reservations module is built (Phase 15).</p>
    </div>
  </div>
</div>
