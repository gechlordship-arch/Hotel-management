<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0">SPA Bookings</h1>
    <p class="text-muted mb-0">Manage treatments and schedules</p>
  </div>
  <div>
    <a href="/spa/services" class="btn btn-outline-primary me-2">View Menu</a>
    <a href="/spa/book" class="btn btn-primary">+ New Booking</a>
  </div>
</div>

<% if (bookings.length === 0) { %>
  <div class="text-center py-5">
    <p class="text-muted">No SPA bookings yet.</p>
    <a href="/spa/book" class="btn btn-primary">Book a Treatment</a>
  </div>
<% } else { %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Guest</th>
            <th>Treatment</th>
            <th>Date & Time</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td>
                <a href="/guests/<%= b.guest_id %>" class="text-decoration-none fw-semibold brand-navy">
                  <%= b.guest.full_name %>
                </a>
              </td>
              <td>
                <%= b.service.name %>
                <div class="small text-muted"><%= b.service.duration_minutes %> mins · $<%= Number(b.service.price).toFixed(2) %></div>
              </td>
              <td>
                <strong><%= new Date(b.booking_date).toLocaleDateString() %></strong>
                <div class="small text-muted">at <%= b.start_time %></div>
              </td>
              <td>
                <span class="badge 
                  <%= b.status === 'scheduled' ? 'bg-primary' : '' %>
                  <%= b.status === 'completed' ? 'bg-success' : '' %>
                  <%= b.status === 'cancelled' ? 'bg-danger' : '' %>
                ">
                  <%= b.status %>
                </span>
              </td>
              <td class="text-end">
                <% if (b.status === 'scheduled') { %>
                  <form action="/spa/<%= b.id %>/status" method="POST" class="d-inline">
                    <input type="hidden" name="status" value="completed" />
                    <button class="btn btn-sm btn-outline-success">Mark Completed</button>
                  </form>
                  <form action="/spa/<%= b.id %>/status" method="POST" class="d-inline">
                    <input type="hidden" name="status" value="cancelled" />
                    <button class="btn btn-sm btn-outline-danger">Cancel</button>
                  </form>
                <% } else { %>
                  <span class="text-muted small">No actions</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
